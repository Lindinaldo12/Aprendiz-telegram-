cd ~/Aprendiz-telegram-

# 1. Atualizar o package.json garantindo a biblioteca express
cat << 'EOF' > package.json
{
  "name": "aprendiz-telegram",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@google/genai": "^0.1.1",
    "@types/express": "^4.17.21",
    "express": "^4.19.2",
    "grammy": "^1.34.0",
    "tsx": "^4.19.1"
  }
}
EOF

# 2. Instalar dependências e atualizar o lockfile
npm install

# 3. Enviar o novo commit para o GitHub
git add package.json package-lock.json src/index.ts src/brain.ts
git commit -m "fix: inclui express no package.json e atualiza servidor"
git push origin main
